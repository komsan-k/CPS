  {
    "id": "fn_ai_predict",
    "type": "function",
    "z": "tab_traffic_twin",
    "name": "AI: smooth + predict + class",
    "func": "// Input msg.payload = current flow (veh/min)\n// Output 1: UI text payload (JSON)\n// Output 2: MQTT cmd to ESP32\n\nlet x = Number(msg.payload);\nif (isNaN(x)) return null;\n\n// Keep history in context\nlet hist = context.get('hist') || [];\nhist.push({t: Date.now(), x});\nif (hist.length > 10) hist.shift();\ncontext.set('hist', hist);\n\n// Moving average (smooth)\nlet avg = hist.reduce((s,p)=>s+p.x,0)/hist.length;\n\n// Simple trend prediction: next = avg + (last-avg)*0.6\nlet last = hist[hist.length-1].x;\nlet pred = avg + (last - avg) * 0.6;\npred = Math.max(0, pred);\n\n// Congestion class thresholds (tune)\n// 0: low, 1: medium, 2: high\nlet cls = 0;\nif (pred >= 35) cls = 2;\nelse if (pred >= 20) cls = 1;\n\n// Map class -> signal timing (ms)\n// High congestion -> longer GREEN\nlet green_ms  = (cls === 2) ? 16000 : (cls === 1) ? 12000 : 9000;\nlet yellow_ms = 2000;\nlet red_ms    = green_ms; // symmetric for demo\n\n// UI payload\nlet ui = {\n  flow_now: x,\n  flow_avg: Math.round(avg*10)/10,\n  flow_pred: Math.round(pred*10)/10,\n  congestion_class: cls,\n  green_ms, yellow_ms, red_ms\n};\n\n// MQTT command\nlet cmd = {\n  mode: \"AUTO\",\n  green_ms,\n  yellow_ms,\n  red_ms\n};\n\nreturn [\n  {payload: ui},\n  {payload: JSON.stringify(cmd), topic: \"traffic/i1/cmd\"}\n];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 220,
    "wires": [
      [
        "ui_text_ai"
      ],
      [
        "out_cmd_mqtt"
      ]
    ]
  },
