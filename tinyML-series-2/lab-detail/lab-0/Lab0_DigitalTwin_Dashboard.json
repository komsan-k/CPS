        "fn_defaults"
      ]
    ]
  },
  {
    "id": "fn_defaults",
    "type": "function",
    "z": "tab1",
    "name": "Defaults + Placeholders",
    "func": "// Ensure expected fields exist and replace null with \"—\" for display.\nconst d = msg.payload || {};\nconst ph = d.placeholders || {};\n\nfunction show(v) {\n  if (v === null || v === undefined || (typeof v === 'number' && isNaN(v))) return '—';\n  return v;\n}\n\nmsg.status = {\n  device_id: show(d.device_id),\n  uptime_s: show(d.uptime_s),\n  rssi_dbm: show(d.rssi_dbm),\n  free_heap: show(d.free_heap),\n};\n\nmsg.sensors = {\n  lux: show(ph.lux),\n  temp_c: show(ph.temp_c),\n  ax_g: show(ph.ax_g),\n  ay_g: show(ph.ay_g),\n  az_g: show(ph.az_g),\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 580,
    "y": 120,
    "wires": [
      [
        "ui_dev_id",
        "ui_uptime",
        "ui_rssi",
        "ui_heap",
        "ui_lux",
        "ui_temp",
        "ui_ax",
        "ui_ay",
        "ui_az"
      ]
    ]
  },
