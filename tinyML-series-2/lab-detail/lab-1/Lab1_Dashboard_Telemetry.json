  {
    "id": "fn1",
    "type": "function",
    "z": "tab1",
    "name": "Normalize + Format",
    "func": "// Convert incoming telemetry into display-friendly messages.\nconst d = msg.payload || {};\nfunction show(v){ if(v===null||v===undefined||(typeof v==='number' && isNaN(v))) return '—'; return v; }\n\n// Lux: raw ADC (0..4095). Also compute normalized 0..1 for charts if desired.\nconst luxRaw = (typeof d.lux_raw === 'number') ? d.lux_raw : null;\nconst luxNorm = (luxRaw!==null) ? luxRaw/4095 : null;\n\nmsg.tele = {\n  device_id: show(d.device_id),\n  lux_raw: show(luxRaw),\n  lux_norm: luxNorm,\n  temp_c: show(d.temp_c),\n  ax_g: show(d.ax_g),\n  ay_g: show(d.ay_g),\n  az_g: show(d.az_g),\n};\n\n// Pass through for UI widgets\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 120,
    "wires": [
      [
        "ui_lux",
        "ui_temp",
        "ui_ax",
        "ui_ay",
        "ui_az",
        "split_lux",
        "split_temp",
        "split_ax",
        "split_ay",
        "split_az"
      ]
    ]
  },
