  {
    "id": "fn_parse_tele",
    "type": "function",
    "z": "tab_lab1",
    "name": "Parse Telemetry JSON",
    "func": "// Expect JSON string like: {\"ldr\":1234,\"led\":1,\"rssi\":-55}\nlet o = msg.payload;\nif (typeof o === 'string') {\n  try { o = JSON.parse(o); } catch(e) { return null; }\n}\nmsg.tele = o;\nmsg.payload = o; // keep for debug\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
