  {
    "id": "fn_build_prompt_ai",
    "type": "function",
    "z": "tab_lab1",
    "name": "Build Prompt for Gemini",
    "func": "const t = flow.get('latestTele');\nif (!t) { msg.payload = 'No telemetry received yet. Wait for ESP32 data.'; return msg; }\n\n// Simple reasoning prompt (student-friendly)\nmsg.payload = `You are assisting a CPS lab.\\n\\nTelemetry (latest): ${JSON.stringify(t)}\\n\\nTasks:\\n1) Summarize system state in 3 bullets.\\n2) Detect possible fault/mismatch (e.g., LED reported ON but LDR unexpectedly low).\\n3) Recommend ONE safe action (e.g., check wiring, adjust threshold, toggle LED).\\n\\nKeep it concise.`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 420,
    "wires": [
      [
        "fn_build_gemini_req"
      ]
    ]
  },
  {
    "id": "fn_build_gemini_req",
    "type": "function",
    "z": "tab_lab1",
    "name": "Build Gemini Request",
    "func": "// Gemini generateContent request\n// Get key: https://aistudio.google.com/app/apikey\n\n// Option A (simple for labs): paste key here\nconst apiKey = 'YOUR_GEMINI_API_KEY_HERE';\n\n// Option B (recommended): use environment variable\n// const apiKey = process.env.GEMINI_API_KEY;\n\nconst model = 'gemini-2.5-flash-lite';\n\nmsg.method = 'POST';\nmsg.url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`;\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = {\n  contents: [{ parts: [{ text: String(msg.payload || '') }] }]\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 420,
    "wires": [
      [
        "http_gemini"
      ]
    ]
  },
  {
    "id": "http_gemini",
    "type": "http request",
    "z": "tab_lab1",
    "name": "Gemini API (generateContent)",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 980,
    "y": 420,
    "wires": [
      [
        "fn_extract_ai"
      ]
    ]
  },
  {
    "id": "fn_extract_ai",
    "type": "function",
    "z": "tab_lab1",
    "name": "Extract Gemini Reply",
    "func": "const res = msg.payload;\nif (res && res.error) {\n  msg.payload = `Gemini error: ${res.error.message || JSON.stringify(res.error)}`;\n  return msg;\n}\nconst text = res?.candidates?.[0]?.content?.parts?.[0]?.text;\nmsg.payload = (typeof text === 'string' && text.length) ? text : ('No text found. Raw:\\n' + JSON.stringify(res, null, 2));\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 230,
    "y": 500,
    "wires": [
      [
        "ui_ai_reply",
        "dbg_ai"
      ]
    ]
