  {
    "id": "safe_filter",
    "type": "function",
    "z": "a1f0c001",
    "name": "Safe Command Filter",
    "func": "let d = String(msg.payload.decision || 'HOLD').trim();\nconst allowed = ['LED_ON', 'LED_OFF', 'HOLD'];\nif (!allowed.includes(d)) d = 'HOLD';\n\nmsg.payload = {\n  target: 'esp32_lab_01',\n  action: d\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1320,
    "y": 360,
    "wires": [
