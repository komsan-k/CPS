  {
    "id": "build_prompt",
    "type": "function",
    "z": "a1f0c001",
    "name": "Build LLM Prompt",
    "func": "const p = msg.payload;\nconst prompt = `You are an agentic controller for an ESP32 lighting system.\\n\\nInputs:\\n- device: ${p.device}\\n- adc: ${p.adc}\\n- light_level: ${p.light_level}\\n- led_state: ${p.led_state}\\n- mode: ${p.mode}\\n\\nRules:\\n1. If mode is MANUAL, do not override the actuator and return HOLD.\\n2. If light_level is dark and mode is AUTO, recommend LED_ON.\\n3. If light_level is bright and mode is AUTO, recommend LED_OFF.\\n4. If light_level is medium, recommend HOLD.\\n5. Return JSON only.\\n\\nRequired JSON format:\\n{\\n  \\\"reasoning\\\": \\\"...\\\",\\n  \\\"decision\\\": \\\"LED_ON\\\" | \\\"LED_OFF\\\" | \\\"HOLD\\\"\\n}`;\n\nmsg.headers = {\n  'Content-Type': 'application/json',\n  'Authorization': 'Bearer YOUR_OPENAI_API_KEY'\n};\n\nmsg.payload = {\n  model: 'gpt-4.1-mini',\n  input: prompt\n};\n\nmsg.original_telemetry = p;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 340,
    "wires": [
      [
        "http_llm"
      ]
    ]
  },
  {
    "id": "http_llm",
    "type": "http request",
    "z": "a1f0c001",
    "name": "LLM API Request",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "https://api.openai.com/v1/responses",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 860,
    "y": 340,
    "wires": [
      [
        "extract_llm_json"
      ]
    ]
  },
  {
    "id": "extract_llm_json",
    "type": "function",
    "z": "a1f0c001",
    "name": "Extract LLM Decision",
    "func": "let text = '';\ntry {\n  if (msg.payload.output && Array.isArray(msg.payload.output)) {\n    for (const item of msg.payload.output) {\n      if (item.content && Array.isArray(item.content)) {\n        for (const c of item.content) {\n          if (c.type === 'output_text' && c.text) text += c.text;\n        }\n      }\n    }\n  }\n} catch (e) {}\n\nif (!text) {\n  text = JSON.stringify({ reasoning: 'No parsable model output', decision: 'HOLD' });\n}\n\nlet decisionObj;\ntry {\n  decisionObj = JSON.parse(text);\n} catch (e) {\n  decisionObj = { reasoning: text, decision: 'HOLD' };\n}\n\nmsg.payload = decisionObj;\nmsg.original_telemetry = msg.original_telemetry || {};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1090,
    "y": 340,
    "wires": [
      [
        "ui_text_reasoning",
        "safe_filter"
      ]
    ]
  },
