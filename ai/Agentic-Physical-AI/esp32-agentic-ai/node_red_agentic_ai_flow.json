    "type": "function",
    "z": "a1f0c001",
    "name": "Prepare Dashboard Values",
    "func": "const p = msg.payload;\nreturn [\n  { payload: Number(p.adc || 0) },\n  { payload: String(p.light_level || '') },\n  { payload: String(p.led_state || '') },\n  { payload: String(p.mode || '') },\n  { payload: Number(p.adc || 0), topic: 'ADC' },\n  { payload: (p.device || 'esp32') + ' | RSSI: ' + (p.rssi || 0) + ' dBm | Last: ' + (p.last_action || '') }\n];",
    "outputs": 6,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
