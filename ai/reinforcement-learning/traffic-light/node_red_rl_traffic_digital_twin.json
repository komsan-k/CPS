  {
    "id": "json_state",
    "type": "json",
    "z": "tab_rl_traffic",
    "name": "Parse State",
    "property": "payload",
    "action": "",
    "pretty": false,
    "x": 330,
    "y": 80,
    "wires": [
      [
        "prep_dashboard",
        "format_log"
      ]
    ]
  },
  {
    "id": "prep_dashboard",
    "type": "function",
    "z": "tab_rl_traffic",
    "name": "Prepare Dashboard Fields",
    "func": "const p = msg.payload || {};\nconst actionMap = {\n    0: 'EW_GREEN',\n    1: 'NS_GREEN'\n};\nconst qMap = {\n    0: 'Low',\n    1: 'Medium',\n    2: 'High'\n};\nreturn [\n    { payload: p.rawEW ?? 0 },\n    { payload: p.rawNS ?? 0 },\n    { payload: p.qEW ?? 0, topic: qMap[p.qEW] || String(p.qEW) },\n    { payload: p.qNS ?? 0, topic: qMap[p.qNS] || String(p.qNS) },\n    { payload: p.state ?? 0 },\n    { payload: actionMap[p.action] || p.action || 'UNKNOWN' },\n    { payload: Number(p.reward ?? 0).toFixed(2) },\n    { payload: p.updatedQ ?? 0 }\n];",
    "outputs": 8,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 80,
    "wires": [
      [
        "gauge_rawew",
        "chart_rawew"
      ],
      [
        "gauge_rawns",
        "chart_rawns"
      ],
      [
        "text_qew"
      ],
      [
        "text_qns"
      ],
      [
        "text_state"
      ],
      [
        "text_action"
      ],
      [
        "text_reward"
      ],
      [
        "text_qvalue",
        "chart_qvalue"
      ]
    ]
  },
  {
    "id": "format_log",
    "type": "function",
    "z": "tab_rl_traffic",
    "name": "Format Decision Log",
    "func": "const p = msg.payload || {};\nconst actionMap = {0:'EW_GREEN',1:'NS_GREEN'};\nconst line = `[${new Date().toLocaleTimeString()}] rawEW=${p.rawEW ?? '-'} rawNS=${p.rawNS ?? '-'} qEW=${p.qEW ?? '-'} qNS=${p.qNS ?? '-'} state=${p.state ?? '-'} action=${actionMap[p.action] || p.action || '-'} reward=${Number(p.reward ?? 0).toFixed(2)} Q=${Number(p.updatedQ ?? 0).toFixed(2)}`;\nmsg.payload = line;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 140,
    "wires": [
      [
        "log_join"
      ]
    ]
  },
  {
    "id": "log_join",
    "type": "function",
    "z": "tab_rl_traffic",
    "name": "Keep Last 12 Logs",
    "func": "let lines = flow.get('rl_logs') || [];\nlines.unshift(msg.payload);\nlines = lines.slice(0, 12);\nflow.set('rl_logs', lines);\nmsg.payload = lines.join('\\n');\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 790,
    "y": 140,
    "wires": [
      [
        "text_log"
      ]
    ]
  },
