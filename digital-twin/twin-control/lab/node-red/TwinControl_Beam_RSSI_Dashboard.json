  {
    "id": "fn_best",
    "type": "function",
    "z": "c1b2a3d4e5f6a7b8",
    "name": "Show best beam",
    "func": "// Expected: {\"best\":7,\"rssi\":-61} or {\"beam\":7,\"rssi\":-61}\nconst p = msg.payload || {};\nconst best = (p.best ?? p.beam ?? p.beam_id ?? p.id);\nconst rssi = (p.rssi ?? p.avg ?? p.rssi_dbm ?? p.RSSI);\nif (best === undefined) return null;\n\nconst out1 = { payload: Number(best) };\nconst out2 = { payload: rssi !== undefined ? Number(rssi) : null };\nconst out3 = { payload: `Best Beam: ${best}` + (rssi !== undefined ? ` | RSSI: ${rssi} dBm` : \"\") };\nreturn [out1, out2, out3];",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
