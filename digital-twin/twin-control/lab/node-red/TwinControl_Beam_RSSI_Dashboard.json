  {
    "id": "fn_accumulate",
    "type": "function",
    "z": "c1b2a3d4e5f6a7b8",
    "name": "Accumulate per-beam RSSI + build chart",
    "func": "// Expected msg.payload formats (any of these):\n// 1) {\"beam\":7,\"rssi\":-62}  (single sample)\n// 2) {\"beam\":7,\"avg\":-62.5} (already averaged)\n// 3) {\"beam_id\":7,\"rssi_dbm\":-62}\n//\n// This function keeps a rolling window per beam and pushes a Beam ID vs RSSI bar chart.\n\nconst beams = 16;              // change if you use more beams\nconst windowN = 15;            // rolling window size per beam\n\nlet state = context.get('state') || {};\nif (!state.samples) state.samples = Array.from({length: beams}, () => []);\nif (!state.latest) state.latest = Array.from({length: beams}, () => null);\n\nconst p = msg.payload || {};\nconst beam = (p.beam ?? p.beam_id ?? p.id ?? p.beamID);\nconst rssi = (p.rssi ?? p.avg ?? p.rssi_dbm ?? p.RSSI);\n\nif (beam === undefined || rssi === undefined) {\n  node.warn(\"Payload must include beam and rssi (e.g., {beam:7,rssi:-62}).\");\n  return null;\n}\nif (beam < 0 || beam >= beams) return null;\n\n// Add to rolling window\nstate.samples[beam].push(Number(rssi));\nif (state.samples[beam].length > windowN) state.samples[beam].shift();\n\n// Compute robust score: median\nconst arr = state.samples[beam].slice().sort((a,b)=>a-b);\nconst mid = Math.floor(arr.length/2);\nconst med = (arr.length % 2) ? arr[mid] : (arr[mid-1] + arr[mid]) / 2;\n\nstate.latest[beam] = med;\ncontext.set('state', state);\n\n// Build chart payload for ui_chart (bar with labels)\nconst labels = Array.from({length: beams}, (_,i)=>String(i));\nconst data = labels.map((_,i)=> state.latest[i] === null ? null : Number(state.latest[i]));\n\n// Node-RED Dashboard ui_chart expects:\n// msg.payload = [{series:[\"RSSI (dBm)\"], data:[[...]], labels:[...]}]\nconst chartMsg = {\n  payload: [{\n    series: [\"RSSI (median, dBm)\"],\n    data: [data],\n    labels: labels\n  }]\n};\n\n// Also output a table-friendly row\nconst rowMsg = {\n  payload: labels.map((lbl,i)=>({beam:i, rssi_median_dbm: state.latest[i]}))\n};\n\nreturn [chartMsg, rowMsg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 650,
    "y": 120,
    "wires": [
      [
        "ui_chart_beam"
      ],
      [
        "ui_table_beam"
      ]
    ]
  },
