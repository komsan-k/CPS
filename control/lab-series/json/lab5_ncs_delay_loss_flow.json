  {
    "id": "0aa3171a77be0868",
    "type": "function",
    "z": "259bf4df329c0e26",
    "name": "PI Controller (Node-RED)",
    "func": "// Centralized PI controller\n// Inputs: msg.payload.y (ADC 0..4095)\nconst sp = Number(flow.get('sp')||2000);\nconst kp = Number(flow.get('kp')||0.08);\nconst ki = Number(flow.get('ki')||0.002);\nconst y = Number(msg.payload.y);\nconst e = sp - y;\nlet I = flow.get('I')||0;\n// Integrate with simple anti-windup clamp\nI = I + ki*e;\nI = Math.max(-255, Math.min(255, I));\nlet u = kp*e + I;\n// saturate\nu = Math.max(0, Math.min(255, Math.round(u)));\nflow.set('I', I);\nmsg.payload = {u: u, sp: sp, y: y, e: e, I: I, kp: kp, ki: ki};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "flow.set('I',0);",
    "finalize": "",
    "x": 1040,
    "y": 420,
    "wires": [
      [
        "3e15713cc98e66b0",
        "3922e9cc98bf7dc6",
        "61c4490423c9b54d"
      ]
    ]
