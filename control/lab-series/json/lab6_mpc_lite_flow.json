  {
    "id": "ace98b2306a76f7b",
    "type": "function",
    "z": "074da9359bad0df8",
    "name": "MPC-lite (1-step candidates)",
    "func": "// Inputs: msg.payload.y (ADC), optional msg.payload.u\n// MPC idea: choose u in candidate set to minimize J=(r-yhat)^2 + lam*u^2\nconst y = Number(msg.payload.y);\nconst r = Number(flow.get('sp')||2000);\nconst lam = Number(flow.get('lam')||0.001);\nconst alpha = Number(flow.get('alpha')||0.90);\n// Candidate set (PWM 0..255)\nconst U = [0,64,128,192,255];\nlet best = {J: Infinity, u: 0, yhat: y};\nfor (const u of U) {\n  // Simple prediction model: yhat = alpha*y + (1-alpha)*map(u)\n  // Map PWM u to ADC range (0..4095) roughly\n  const u_adc = (u/255)*4095;\n  const yhat = alpha*y + (1-alpha)*u_adc;\n  const J = Math.pow(r - yhat, 2) + lam*Math.pow(u,2);\n  if (J < best.J) best = {J, u, yhat};\n}\nmsg.payload = {u: best.u, sp: r, y: y, yhat: best.yhat, J: best.J, lam: lam, alpha: alpha};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 630,
    "y": 300,
    "wires": [
      [
        "e3eef292877e2069",
        "f07ee2ef8b2334c5",
        "68c22a884ecc0d32"
      ]
    ]
