  {
    "id": "39893d7136579028",
    "type": "function",
    "z": "8d1cc747370534fd",
    "name": "PI Controller (Lab5)",
    "func": "const sp=Number(flow.get('sp')||2000);\nconst kp=Number(flow.get('kp')||0.08);\nconst ki=Number(flow.get('ki')||0.002);\nconst y=Number(msg.payload.y);\nconst e=sp-y;\nlet I=flow.get('I5')||0;\nI=I+ki*e; I=Math.max(-255,Math.min(255,I));\nlet u=Math.round(kp*e + I);\nu=Math.max(0,Math.min(255,u));\nflow.set('I5',I);\nmsg.payload={u:u};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "flow.set('I5',0);",
    "finalize": "",
    "x": 1270,
