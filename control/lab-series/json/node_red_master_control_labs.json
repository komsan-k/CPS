  {
    "id": "a93f28180d60507d",
    "type": "function",
    "z": "8d1cc747370534fd",
    "name": "MPC-lite (Lab6)",
    "func": "const y=Number(msg.payload.y);\nconst r=Number(flow.get('sp6')||2000);\nconst lam=Number(flow.get('lam6')||0.001);\nconst alpha=Number(flow.get('alpha6')||0.90);\nconst U=[0,64,128,192,255];\nlet best={J:Infinity,u:0,yhat:y};\nfor (const u of U){\n  const u_adc=(u/255)*4095;\n  const yhat=alpha*y+(1-alpha)*u_adc;\n  const J=Math.pow(r-yhat,2)+lam*Math.pow(u,2);\n  if(J<best.J) best={J,u,yhat};\n}\nmsg.payload={u:best.u, y:y, yhat:best.yhat, J:best.J};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 560,
    "y": 1540,
