  },
  {
    "id": "fn-health",
    "type": "function",
    "z": "tab1",
    "name": "Health Check (NORMAL/FAIL)",
    "func": "// Evaluate health using lastCmd and lastLux\n// Tuning:\nconst LUX_MIN_ON = 250;  // If command is ON but lux stays below this -> FAIL\n\n// Extract lux from either telemetry or state\nlet lux = undefined;\nif (typeof msg.payload === 'object' && msg.payload !== null) {\n  if (typeof msg.payload.lux !== 'undefined') lux = Number(msg.payload.lux);\n}\n\nif (typeof lux === 'number' && !Number.isNaN(lux)) {\n  flow.set('lastLux', lux);\n}\n\nconst lastCmd = (flow.get('lastCmd') || 'OFF').toString().toUpperCase();\nconst lastLux = Number(flow.get('lastLux') || 0);\n\nlet status = 'NORMAL';\nif (lastCmd === 'ON' && lastLux < LUX_MIN_ON) {\n  status = 'FAIL';\n}\n\n// Output a clean message for dashboard text\nreturn {\n  payload: status,\n  topic: 'health'\n};",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 390,
    "y": 410,
    "wires": [
      [
        "ui-health-text",
        "debug-health"
      ]
    ]
