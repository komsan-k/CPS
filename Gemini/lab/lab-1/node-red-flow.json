    {
        "id": "decision_hysteresis",
        "type": "function",
        "z": "f0a1b2c3d4e5f6a7",
        "name": "Decision (pred thresholds → LED cmd)",
        "func": "// Simple Configuration logic using predicted lux\n// If predicted lux < LOW -> LED ON\n// If predicted lux > HIGH -> LED OFF\n// Sends command only when it changes (hysteresis via state)\n\nconst LOW = 50;   // tune\nconst HIGH = 200; // tune\n\nconst pred = Number(msg.pred_lux);\nif (!Number.isFinite(pred)) return null;\n\nlet state = context.get(\"led_state\") || \"UNKNOWN\"; // ON/OFF\nlet cmd = null;\n\nif (pred < LOW && state !== \"ON\") {\n  cmd = \"ON\";\n  state = \"ON\";\n}\n\nif (pred > HIGH && state !== \"OFF\") {\n  cmd = \"OFF\";\n  state = \"OFF\";\n}\n\ncontext.set(\"led_state\", state);\n\nif (!cmd) return null;\n\nreturn {\n  topic: \"cps/led/cmd\",\n  payload: cmd,\n  pred_lux: pred,\n  led_state: state\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
