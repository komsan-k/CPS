    {
        "id": "extract_fields",
        "type": "function",
        "z": "f0a1b2c3d4e5f6a7",
        "name": "Extract lux_now",
        "func": "// Expect payload from ESP32:\n// {device, ts, adc, v, lux_index, lux_smooth, rssi}\n\nconst p = msg.payload || {};\n\n// Prefer lux_smooth if present, else lux_index\nconst lux = Number(p.lux_smooth ?? p.lux_index);\nif (!Number.isFinite(lux)) return null;\n\nmsg.device = p.device || \"unknown\";\nmsg.ts = p.ts ?? Date.now();\nmsg.lux_now = lux;\nmsg.rssi = p.rssi;\nmsg.adc = p.adc;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "x": 570,
        "y": 120,
        "wires": [
            [
                "predict_future",
                "ui_now_text"
            ]
        ]
    },
    {
        "id": "predict_future",
        "type": "function",
        "z": "f0a1b2c3d4e5f6a7",
        "name": "Cognition: slope + predict",
        "func": "// Simple CPS Cognition: linear trend extrapolation\n// Keeps last N samples, estimates slope, predicts lux at horizonSec\n\nconst N = 20;\nconst horizonSec = 5;\n\nconst lux = Number(msg.lux_now);\nif (!Number.isFinite(lux)) return null;\n\nconst t = Date.now();\n\nlet buf = context.get(\"buf\") || [];\nbuf.push({ t, lux });\nif (buf.length > N) buf.shift();\n\nlet slope = 0;\nlet pred = lux;\n\nif (buf.length >= 2) {\n  const a = buf[0];\n  const b = buf[buf.length - 1];\n  const dt = (b.t - a.t) / 1000;\n  if (dt > 0) slope = (b.lux - a.lux) / dt; // lux per second\n  pred = b.lux + slope * horizonSec;\n}\n\ncontext.set(\"buf\", buf);\n\nmsg.slope = slope;\nmsg.pred_lux = pred;\nmsg.horizon_s = horizonSec;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 120,
        "wires": [
            [
                "chart_format",
                "ui_pred_text",
                "decision_hysteresis"
            ]
        ]
    },
    {
        "id": "chart_format",
        "type": "function",
        "z": "f0a1b2c3d4e5f6a7",
        "name": "Format for chart (2 series)",
        "func": "// ui_chart uses msg.topic to separate series\n// Output 2 messages: lux_now and pred_lux\n\nconst nowLux = Number(msg.lux_now);\nconst predLux = Number(msg.pred_lux);\n\nif (!Number.isFinite(nowLux) || !Number.isFinite(predLux)) return null;\n\nconst m1 = {\n  topic: \"lux_now\",\n  payload: nowLux,\n  timestamp: Date.now()\n};\n\nconst m2 = {\n  topic: \"pred_lux(+\" + (msg.horizon_s || 5) + \"s)\",\n  payload: predLux,\n  timestamp: Date.now()\n};\n\nreturn [m1, m2];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "x": 1070,
        "y": 80,
        "wires": [
            [
                "ui_chart_lux"
            ],
            [
                "ui_chart_lux"
            ]
        ]
    },
