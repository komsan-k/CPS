  {
    "id": "fn_extract",
    "type": "function",
    "z": "tab_cps",
    "name": "Extract fields for UI",
    "func": "// Expected payload format from ESP32:\n// {\n//   ts, adc, x, p:[p0,p1,p2], class, mode, lat_us\n// }\n\nconst p = msg.payload || {};\nconst probs = Array.isArray(p.p) ? p.p : [null,null,null];\n\n// Build nice status text\nconst status = `class=${p.class ?? '?'} | mode=${p.mode ?? '?'} | x=${(p.x ?? 0).toFixed?.(3) ?? p.x} | adc=${p.adc ?? '?'} | lat_us=${p.lat_us ?? '?'}`;\n\n// Output messages for different widgets\nreturn [\n  { payload: status },                            // status text\n  { payload: p.class ?? \"?\" },                   // class text\n  { payload: p.adc ?? 0 },                        // adc\n  { payload: p.x ?? 0 },                          // x gauge\n  { payload: p.lat_us ?? 0 },                     // latency\n  { payload: (probs[0] ?? 0) * 100 },             // p0 gauge (percent)\n  { payload: (probs[1] ?? 0) * 100 },             // p1 gauge\n  { payload: (probs[2] ?? 0) * 100 },             // p2 gauge\n  { payload: p.x ?? 0, topic: \"x\" }              // chart x\n];",
    "outputs": 9,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 580,
    "y": 120,
    "wires": [
      [
        "ui_text_status"
      ],
      [
        "ui_text_class"
      ],
      [
        "ui_text_adc"
      ],
      [
        "ui_gauge_x"
      ],
      [
        "ui_text_lat"
      ],
      [
        "ui_gauge_p0"
      ],
      [
        "ui_gauge_p1"
      ],
      [
        "ui_gauge_p2"
      ],
      [
        "ui_chart_x"
      ]
    ]
  },
