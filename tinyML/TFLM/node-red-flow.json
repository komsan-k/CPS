    "id": "fn_rate_to_cmd",
    "type": "function",
    "z": "tab_cps",
    "name": "rate:N → cmd",
    "func": "const v = Number(msg.payload);\nif (Number.isFinite(v)) {\n  msg.payload = `rate:${Math.round(v)}`;\n  return msg;\n}\nreturn null;",
