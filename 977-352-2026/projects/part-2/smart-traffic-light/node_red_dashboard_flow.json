  {
    "id": "fn_unpack",
    "type": "function",
    "z": "f1a1b2c3d4e5f601",
    "name": "Unpack fields",
    "func": "// Expected payload example:\\n// {\\n//   \\\"ew1\\\":1,\\\"ew2\\\":0,\\\"ns1\\\":1,\\\"ns2\\\":1,\\n//   \\\"ew_queue\\\":0.6,\\\"ns_queue\\\":1.0,\\n//   \\\"phase\\\":\\\"EW\\\",\\\"green_time\\\":12.5,\\\"action\\\":1\\n// }\\n\\nconst p = msg.payload || {};\\n\\nconst status = {\\n    phase: p.phase || 'EW',\\n    green_time: p.green_time || 0,\\n    action: p.action || 0\\n};\\n\\nconst traffic = [\\n    {topic:'EW Sensor 1', payload: Number(p.ew1 || 0)},\\n    {topic:'EW Sensor 2', payload: Number(p.ew2 || 0)},\\n    {topic:'NS Sensor 1', payload: Number(p.ns1 || 0)},\\n    {topic:'NS Sensor 2', payload: Number(p.ns2 || 0)}\\n];\\n\\nconst queueEW = {topic:'EW Queue', payload: Number(p.ew_queue || 0)};\\nconst queueNS = {topic:'NS Queue', payload: Number(p.ns_queue || 0)};\\n\\nreturn [\\n    {payload: status.phase},\\n    {payload: status.green_time},\\n    {payload: status.action},\\n    traffic[0],\\n    traffic[1],\\n    traffic[2],\\n    traffic[3],\\n    queueEW,\\n    queueNS,\\n    {payload: p}\\n];",
    "outputs": 10,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 80,
    "wires": [
      ["ui_phase"],
      ["ui_green_time","chart_green"],
      ["ui_action"],
      ["gauge_ew1"],
      ["gauge_ew2"],
      ["gauge_ns1"],
      ["gauge_ns2"],
      ["chart_queue"],
      ["chart_queue"],
      ["debug_state"]
    ]
  },
