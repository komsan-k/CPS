  {
    "id": "ui_digital_twin",
    "type": "ui_template",
    "z": "f1a1b2c3d4e5f601",
    "group": "ui_group_twin",
    "name": "Intersection Digital Twin",
    "order": 1,
    "width": "12",
    "height": "10",
    "format": "<style>\n  .twin-wrap{padding:8px;background:#f7f7f7;border-radius:10px}\n  .twin-title{font-weight:600;margin-bottom:8px}\n  .twin-meta{font-size:13px;margin:6px 0 10px 0}\n  .lamp{stroke:#333;stroke-width:2}\n  .lane-label{font-size:12px;fill:#333;font-family:sans-serif}\n  .sensor-on{fill:#111}\n  .sensor-off{fill:#ddd}\n  .road{fill:#444}\n  .mark{stroke:#fff;stroke-width:3;stroke-dasharray:8 8}\n</style>\n<div class=\"twin-wrap\">\n  <div class=\"twin-title\">Digital Twin: Single Intersection</div>\n  <div class=\"twin-meta\">\n    Phase: <b>{{msg.payload.phase}}</b> |\n    Green Time: <b>{{msg.payload.green_time}}</b> s |\n    Action: <b>{{msg.payload.action}}</b> |\n    Pedestrian: <b>{{msg.payload.pedestrian ? 'Requested' : 'None'}}</b> |\n    Walk: <b>{{msg.payload.walk_signal ? 'ON' : 'OFF'}}</b>\n  </div>\n\n  <svg viewBox=\"0 0 600 420\" width=\"100%\" height=\"360\">\n    <!-- roads -->\n    <rect class=\"road\" x=\"0\" y=\"150\" width=\"600\" height=\"120\"></rect>\n    <rect class=\"road\" x=\"240\" y=\"0\" width=\"120\" height=\"420\"></rect>\n\n    <!-- lane marks -->\n    <line class=\"mark\" x1=\"0\" y1=\"210\" x2=\"230\" y2=\"210\"></line>\n    <line class=\"mark\" x1=\"370\" y1=\"210\" x2=\"600\" y2=\"210\"></line>\n    <line class=\"mark\" x1=\"300\" y1=\"0\" x2=\"300\" y2=\"140\"></line>\n    <line class=\"mark\" x1=\"300\" y1=\"280\" x2=\"300\" y2=\"420\"></line>\n\n    <!-- crosswalks -->\n    <rect x=\"220\" y=\"136\" width=\"160\" height=\"10\" fill=\"{{msg.payload.walk_signal ? '#34c759' : '#cccccc'}}\"></rect>\n    <rect x=\"220\" y=\"274\" width=\"160\" height=\"10\" fill=\"{{msg.payload.walk_signal ? '#34c759' : '#cccccc'}}\"></rect>\n    <rect x=\"226\" y=\"130\" width=\"10\" height=\"160\" fill=\"{{msg.payload.walk_signal ? '#34c759' : '#cccccc'}}\"></rect>\n    <rect x=\"364\" y=\"130\" width=\"10\" height=\"160\" fill=\"{{msg.payload.walk_signal ? '#34c759' : '#cccccc'}}\"></rect>\n\n    <!-- EW traffic light -->\n    <circle class=\"lamp\" cx=\"180\" cy=\"125\" r=\"16\" fill=\"{{msg.payload.ew_red ? '#ff3b30' : '#555'}}\"></circle>\n    <circle class=\"lamp\" cx=\"180\" cy=\"155\" r=\"16\" fill=\"{{msg.payload.ew_yellow ? '#ffd60a' : '#555'}}\"></circle>\n    <circle class=\"lamp\" cx=\"180\" cy=\"185\" r=\"16\" fill=\"{{msg.payload.ew_green ? '#34c759' : '#555'}}\"></circle>\n\n    <!-- NS traffic light -->\n    <circle class=\"lamp\" cx=\"415\" cy=\"300\" r=\"16\" fill=\"{{msg.payload.ns_red ? '#ff3b30' : '#555'}}\"></circle>\n    <circle class=\"lamp\" cx=\"445\" cy=\"300\" r=\"16\" fill=\"{{msg.payload.ns_yellow ? '#ffd60a' : '#555'}}\"></circle>\n    <circle class=\"lamp\" cx=\"475\" cy=\"300\" r=\"16\" fill=\"{{msg.payload.ns_green ? '#34c759' : '#555'}}\"></circle>\n\n    <!-- sensor indicators -->\n    <circle cx=\"80\" cy=\"175\" r=\"12\" fill=\"{{msg.payload.ew1 ? '#111' : '#ddd'}}\" stroke=\"#333\" stroke-width=\"2\"></circle>\n    <circle cx=\"205\" cy=\"175\" r=\"12\" fill=\"{{msg.payload.ew2 ? '#111' : '#ddd'}}\" stroke=\"#333\" stroke-width=\"2\"></circle>\n    <circle cx=\"270\" cy=\"70\" r=\"12\" fill=\"{{msg.payload.ns1 ? '#111' : '#ddd'}}\" stroke=\"#333\" stroke-width=\"2\"></circle>\n    <circle cx=\"270\" cy=\"145\" r=\"12\" fill=\"{{msg.payload.ns2 ? '#111' : '#ddd'}}\" stroke=\"#333\" stroke-width=\"2\"></circle>\n\n    <!-- vehicle blocks EW -->\n    <rect x=\"40\" y=\"228\" width=\"{{20 + (msg.payload.ew_queue * 120)}}\" height=\"18\" fill=\"#5ac8fa\"></rect>\n    <rect x=\"440\" y=\"174\" width=\"{{20 + (msg.payload.ew_queue * 120)}}\" height=\"18\" fill=\"#5ac8fa\"></rect>\n\n    <!-- vehicle blocks NS -->\n    <rect x=\"258\" y=\"20\" width=\"18\" height=\"{{20 + (msg.payload.ns_queue * 120)}}\" fill=\"#ff9f0a\"></rect>\n    <rect x=\"324\" y=\"280\" width=\"18\" height=\"{{20 + (msg.payload.ns_queue * 120)}}\" fill=\"#ff9f0a\"></rect>\n\n    <!-- pedestrian icon -->\n    <circle cx=\"520\" cy=\"70\" r=\"12\" fill=\"{{msg.payload.pedestrian ? '#af52de' : '#ccc'}}\"></circle>\n    <rect x=\"515\" y=\"82\" width=\"10\" height=\"26\" fill=\"{{msg.payload.pedestrian ? '#af52de' : '#ccc'}}\"></rect>\n    <line x1=\"520\" y1=\"92\" x2=\"505\" y2=\"112\" stroke=\"{{msg.payload.pedestrian ? '#af52de' : '#ccc'}}\" stroke-width=\"4\"></line>\n    <line x1=\"520\" y1=\"92\" x2=\"535\" y2=\"112\" stroke=\"{{msg.payload.pedestrian ? '#af52de' : '#ccc'}}\" stroke-width=\"4\"></line>\n    <line x1=\"520\" y1=\"108\" x2=\"508\" y2=\"132\" stroke=\"{{msg.payload.pedestrian ? '#af52de' : '#ccc'}}\" stroke-width=\"4\"></line>\n    <line x1=\"520\" y1=\"108\" x2=\"532\" y2=\"132\" stroke=\"{{msg.payload.pedestrian ? '#af52de' : '#ccc'}}\" stroke-width=\"4\"></line>\n\n    <!-- labels -->\n    <text x=\"62\" y=\"156\" class=\"lane-label\">EW S1</text>\n    <text x=\"186\" y=\"156\" class=\"lane-label\">EW S2</text>\n    <text x=\"250\" y=\"54\" class=\"lane-label\">NS S1</text>\n    <text x=\"250\" y=\"129\" class=\"lane-label\">NS S2</text>\n    <text x=\"120\" y=\"115\" class=\"lane-label\">EW Light</text>\n    <text x=\"410\" y=\"332\" class=\"lane-label\">NS Light</text>\n    <text x=\"485\" y=\"150\" class=\"lane-label\">Pedestrian</text>\n    <text x=\"30\" y=\"205\" class=\"lane-label\">EW Queue</text>\n    <text x=\"345\" y=\"25\" class=\"lane-label\">NS Queue</text>\n  </svg>\n</div>",
