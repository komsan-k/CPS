        "gauge_ns1"
      ],
      [
        "gauge_ns2"
      ],
      [
        "chart_queue"
      ],
      [
        "chart_queue"
      ],
      [
        "ped_chart"
      ],
      [
        "ui_digital_twin",
        "ui_twin_json"
      ],
      [
        "debug_state"
      ]
    ]
  },
