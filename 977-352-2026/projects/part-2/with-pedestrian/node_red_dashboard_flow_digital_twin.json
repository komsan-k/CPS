  {
    "id": "fn_unpack",
    "type": "function",
    "z": "f1a1b2c3d4e5f601",
    "name": "Unpack + twin state",
    "func": "// Expected payload example:\n// {\n//   \"ew1\":1,\"ew2\":0,\"ns1\":1,\"ns2\":1,\n//   \"ew_queue\":0.6,\"ns_queue\":1.0,\n//   \"phase\":\"EW\",\"green_time\":12.5,\"action\":1,\n//   \"pedestrian\":1,\"walk_signal\":0\n// }\n\nconst p = msg.payload || {};\nconst phase = p.phase || 'EW';\n\nconst twin = {\n    phase: phase,\n    green_time: Number(p.green_time || 0),\n    action: Number(p.action || 0),\n    ew1: Number(p.ew1 || 0),\n    ew2: Number(p.ew2 || 0),\n    ns1: Number(p.ns1 || 0),\n    ns2: Number(p.ns2 || 0),\n    ew_queue: Number(p.ew_queue || 0),\n    ns_queue: Number(p.ns_queue || 0),\n    pedestrian: Number(p.pedestrian || 0),\n    walk_signal: Number(p.walk_signal || 0),\n    ew_red: phase === 'NS' ? 1 : 0,\n    ew_yellow: p.ew_yellow ? 1 : 0,\n    ew_green: phase === 'EW' ? 1 : 0,\n    ns_red: phase === 'EW' ? 1 : 0,\n    ns_yellow: p.ns_yellow ? 1 : 0,\n    ns_green: phase === 'NS' ? 1 : 0\n};\n\nreturn [\n    {payload: phase},\n    {payload: Number(p.green_time || 0), topic: 'Green Time'},\n    {payload: Number(p.action || 0)},\n    {payload: Number(p.pedestrian || 0) ? 'Requested' : 'None'},\n    {payload: Number(p.walk_signal || 0)},\n    {payload: Number(p.ew1 || 0)},\n    {payload: Number(p.ew2 || 0)},\n    {payload: Number(p.ns1 || 0)},\n    {payload: Number(p.ns2 || 0)},\n    {topic:'EW Queue', payload: Number(p.ew_queue || 0)},\n    {topic:'NS Queue', payload: Number(p.ns_queue || 0)},\n    {topic:'Ped Request', payload: Number(p.pedestrian || 0)},\n    {payload: twin},\n    {payload: p}\n];\n",
    "outputs": 14,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 80,
    "wires": [
      [
        "ui_phase"
      ],
      [
        "ui_green_time",
        "chart_green"
      ],
      [
        "ui_action"
      ],
      [
        "ped_status_text"
      ],
      [
        "ped_walk_indicator"
      ],
      [
        "gauge_ew1"
      ],
      [
        "gauge_ew2"
      ],
