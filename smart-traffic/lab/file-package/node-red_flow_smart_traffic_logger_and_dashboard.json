  {
    "id": "fn-history-dataset",
    "type": "function",
    "z": "a1b2c3d4e5f6a7b8",
    "name": "build dataset row (t -> label t+1)",
    "func": "\n// Input msg.payload from traffic_10s:\n// {ns_10s, ew_10s, ...}\n//\n// We build supervised rows using 3-window history:\n// features at time t: [ns0,ew0,ns1,ew1,ns2,ew2]\n// label y = class(total at time t+1)\n//\n// Trick: when a new window arrives (this is t+1),\n// we can finalize the previous feature vector (t) by using current total as label.\n\nconst ns = Number(msg.payload.ns_10s || 0);\nconst ew = Number(msg.payload.ew_10s || 0);\nconst total = ns + ew;\n\n// Label rule (same as README)\nlet y = 0;\nif (total <= 3) y = 0;\nelse if (total <= 8) y = 1;\nelse y = 2;\n\n// history stored in context: [ns0,ew0,ns1,ew1,ns2,ew2] for previous window t\nconst prev = context.get(\"prev_features\");\n\n// Update context with current window to become \"previous\" for next round\n// Shift 3-window history in context:\nlet hist = context.get(\"hist\") || {ns0:0, ew0:0, ns1:0, ew1:0, ns2:0, ew2:0};\nhist.ns2 = hist.ns1; hist.ew2 = hist.ew1;\nhist.ns1 = hist.ns0; hist.ew1 = hist.ew0;\nhist.ns0 = ns;       hist.ew0 = ew;\n\n// New features for current window (to be labeled by next message)\nconst features_now = [hist.ns0, hist.ew0, hist.ns1, hist.ew1, hist.ns2, hist.ew2];\ncontext.set(\"prev_features\", features_now);\ncontext.set(\"hist\", hist);\n\n// Output dataset row for previous window, labeled by current window\n// (skip first few messages until we have a meaningful prev)\nif (!prev) return null;\n\nmsg.dataset = {\n  ns0: prev[0], ew0: prev[1], ns1: prev[2], ew1: prev[3], ns2: prev[4], ew2: prev[5],\n  y: y\n};\n\n// Pass through also gauge values for dashboard\nmsg.ui = {ns: ns, ew: ew, total: total, y: y};\n\nreturn [msg, msg, msg, msg];\n",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 200,
    "wires": [
      [
        "csv-row"
      ],
      [
        "fn-class-text"
      ],
      [
        "dbg-dataset"
      ],
      [
        "fn-class-gauge"
      ]
    ]
  },
  {
    "id": "csv-row",
    "type": "function",
    "z": "a1b2c3d4e5f6a7b8",
    "name": "to CSV line",
    "func": "\nconst d = msg.dataset;\nif (!d) return null;\nconst line = `${d.ns0},${d.ew0},${d.ns1},${d.ew1},${d.ns2},${d.ew2},${d.y}\\n`;\nmsg.payload = line;\nreturn msg;\n",
    "outputs": 1,
    "noerr": 0,
    "x": 580,
    "y": 220,
    "wires": [
      [
        "file-out"
      ]
    ]
  },
