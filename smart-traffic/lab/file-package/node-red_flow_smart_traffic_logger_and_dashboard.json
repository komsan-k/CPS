    "id": "fn-class-text",
    "type": "function",
    "z": "a1b2c3d4e5f6a7b8",
    "name": "label text from y",
    "func": "\nif (!msg.ui) return null;\nconst y = msg.ui.y;\nconst label = (y===0)?\"LOW\":(y===1)?\"MEDIUM\":\"HIGH\";\nmsg.payload = label;\nreturn msg;\n",
