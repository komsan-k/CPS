    "id": "fn-gauge-values",
    "type": "function",
    "z": "a1b2c3d4e5f6a7b8",
    "name": "gauge values",
    "func": "\n// From msg.payload (traffic json)\nconst ns = Number(msg.payload.ns_10s || 0);\nconst ew = Number(msg.payload.ew_10s || 0);\nconst total = ns + ew;\n// output separate messages for gauges\nreturn [\n  {payload: ns},\n  {payload: ew},\n  {payload: total},\n  msg\n];\n",
