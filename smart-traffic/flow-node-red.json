  {
    "id": "fn_update_twin",
    "type": "function",
    "z": "f1a6f0b1c2b3d4e5",
    "name": "Update Twin State + Scores",
    "func": "// Expected payload examples:\n// 1) {\"NS\":1,\"EW\":0}  (presence)\n// 2) {\"NS\":12,\"EW\":5} (counts)\n\nconst p = msg.payload || {};\nlet ns = Number(p.NS ?? 0);\nlet ew = Number(p.EW ?? 0);\n\n// Treat presence as a small count\nif (ns === 0 || ns === 1) ns = ns * 10; \nif (ew === 0 || ew === 1) ew = ew * 10;\n\n// Simple congestion scores (0..100)\nconst maxCount = 60; // saturation point\nconst scoreNS = Math.max(0, Math.min(100, Math.round((ns / maxCount) * 100)));\nconst scoreEW = Math.max(0, Math.min(100, Math.round((ew / maxCount) * 100)));\n\n// Save twin state in flow context\nconst state = {\n  ts: Date.now(),\n  ns_count: ns,\n  ew_count: ew,\n  ns_score: scoreNS,\n  ew_score: scoreEW\n};\nflow.set('i1_state', state);\n\n// Output multiple messages for dashboard\nreturn [\n  {payload: scoreNS, topic: 'NS_score'},\n  {payload: scoreEW, topic: 'EW_score'},\n  {payload: {ns: ns, ew: ew, ns_score: scoreNS, ew_score: scoreEW, ts: state.ts}}\n];",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 660,
    "y": 120,
    "wires": [
      [
        "ui_gauge_ns"
      ],
      [
        "ui_gauge_ew"
      ],
      [
        "ui_chart_scores",
        "ui_text_counts",
        "fn_decision_engine"
      ]
    ]
  },
