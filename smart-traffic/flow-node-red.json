  {
    "id": "fn_decision_engine",
    "type": "function",
    "z": "f1a6f0b1c2b3d4e5",
    "name": "Decision Engine (AUTO/MANUAL)",
    "func": "const mode = flow.get('i1_mode') || 'AUTO';\nconst manualGreen = flow.get('i1_manual_green') || 30;\n\nconst ns_score = Number(msg.payload.ns_score ?? 0);\nconst ew_score = Number(msg.payload.ew_score ?? 0);\n\n// Default phase decision\nlet phase = 'NS_GREEN';\nif (ew_score > ns_score) phase = 'EW_GREEN';\n\n// Compute green time (seconds)\n// Base 20s + extra up to 40s based on dominance\nlet green_time = 20;\nconst diff = Math.abs(ns_score - ew_score); // 0..100\ngreen_time = 20 + Math.round((diff / 100) * 40); // 20..60\n\nif (mode === 'MANUAL') {\n  // Manual forces phase to NS_GREEN by default; you can change this if you add another selector\n  phase = 'NS_GREEN';\n  green_time = manualGreen;\n}\n\n// Save last command as twin control state\nconst cmd = {\n  intersection: 'intersection1',\n  mode,\n  phase,\n  green_time,\n  ts: Date.now()\n};\nflow.set('i1_cmd', cmd);\n\n// Send to dashboard + MQTT out\nreturn [\n  {payload: cmd, topic: 'cmd'},\n  {payload: cmd.phase},\n  {payload: cmd.green_time},\n  {payload: cmd}\n];",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
